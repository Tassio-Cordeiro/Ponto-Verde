{
  "name": "totem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests README.md docs package.json index.html vite.config.ts",
    "format:check": "prettier --check src tests README.md docs package.json index.html vite.config.ts"
  },
  "dependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/form": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@tabler/icons-react": "3.35.0",
    "axios": "1.21.0",
    "mantine-form-zod-resolver": "1.3.0",
    "msw": "2.12.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.89.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
